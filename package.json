{
  "name": "irreverents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Irreverents: a browser-played 2D action-adventure. See CLAUDE.md and docs/architecture.md.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/check.ts",
    "gates": "node scripts/gates.ts",
    "start": "exec node dist/server.cjs",
    "dev": "node scripts/dev.ts",
    "e2e": "NODE_PATH=/opt/node-tools/node_modules node scripts/e2e.ts",
    "check:live": "NODE_PATH=/opt/node-tools/node_modules node scripts/e2e.ts --live",
    "check:deployed": "node scripts/check-deployed.ts"
  },
  "dependencies": { "ws": "8.23.0" },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
