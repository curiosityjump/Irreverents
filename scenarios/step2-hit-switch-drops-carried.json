{
  "id": "step2-hit-switch-drops-carried",
  "gate": "A",
  "proves": "a carrier who switches character lets go of what they carry (the new body may be too weak for it): the heavy crate is released and comes to rest on the floor, held by nobody",
  "room": "test-hit",
  "players": [{ "id": "a", "character": "grappler", "spawn": 0 }],
  "entities": [{ "id": "crate-heavy-1", "character": "crate-heavy", "tile": [3, 6] }],
  "inputs": [
    { "player": "a", "from": 5, "to": 8, "hold": ["grab"] },
    { "player": "a", "from": 30, "to": 33, "hold": ["switch"] }
  ],
  "ticks": 120,
  "expect": [
    { "fact": "body-state", "entity": "crate-heavy-1", "at": 29, "is": ["held"] },
    { "fact": "event", "event": "switched", "player": "a", "between": [30, 30] },
    { "fact": "event", "event": "released", "between": [30, 31], "where": { "target": "crate-heavy-1", "how": "dropped" } },
    { "fact": "body-state", "player": "a", "at": 32, "not": ["carrying"] },
    { "fact": "body-state", "entity": "crate-heavy-1", "at": 120, "not": ["held", "flying"] },
    { "fact": "position", "entity": "crate-heavy-1", "at": 120, "y": [112, 112] }
  ]
}
