@@ -0,0 +1,39 @@
+import { checkOnly, isRange, isTick } from '../fact-helpers.ts';
+import type { Fact } from '../types.ts';
+
+/**
+ * { "fact": "entity-bytes", "entity": "hall:watch", "between": [0, 600], "max": 800 }
+ * On every tick of the span on which entity `entity` is in the world, it
+ * is at most `max` characters of JSON (what the network sends for it), and
+ * it is in the world on at least one of them. Any entity id may be named,
+ * including ones the simulation makes itself.
+ */
+const fact: Fact = {
+  id: 'entity-bytes',
+  validate(spec, scenario) {
+    const out: string[] = [];
+    checkOnly(spec, ['entity', 'between', 'max'], out);
+    if (typeof spec.entity !== 'string' || spec.entity === '') out.push(`entity: must be an entity id, but is ${JSON.stringify(spec.entity)}`);
+    const b = spec.between;
+    if (!isRange(b) || !isTick(b[0], scenario) || !isTick(b[1], scenario)) out.push(`between: must be [first tick, last tick] within 0 to ${scenario.ticks}, but is ${JSON.stringify(b)}`);
+    if (typeof spec.max !== 'number' || spec.max < 1) out.push(`max: must be a number of characters from 1, but is ${JSON.stringify(spec.max)}`);
+    return out;
+  },
+  test(spec, rec) {
+    const [from, to] = spec.between as [number, number];
+    let biggest = -1;
+    let when = -1;
+    for (let t = from; t <= to; t++) {
+      const e = rec.history[t]?.entities.find((x) => x.id === spec.entity);
+      if (!e) continue;
+      const size = JSON.stringify(e).length;
+      if (size > biggest) {
+        biggest = size;
+        when = t;
+      }
+    }
+    if (biggest < 0) return `entity ${String(spec.entity)} is not in the world on any tick from ${from} to ${to}`;
+    return biggest <= (spec.max as number) ? null : `entity ${String(spec.entity)} is ${biggest} characters of JSON at tick ${when}, expected at most ${String(spec.max)}`;
+  },
+};
+export default fact;
