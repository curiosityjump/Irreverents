+import { describe, isRecord, known } from '../../content/reader.ts';
+import { FRAME_CREDITED, PEDESTAL_KIND, pedestalId } from '../../sim/hall/record.ts';
+import { checkAt, checkOnly, isRange, isTick } from '../fact-helpers.ts';
+import type { Fact } from '../types.ts';
+
+/**
+ * { "fact": "hall-record", "n": 1, "at": 600, "kind": "escape", "place": "test-body",
+ *   "who": ["a", "b"], "stats": { "hits": [1, 1], "calls": [0, 0] }, "frameAt": 240 }
+ * At tick `at`, Hall of Legends record number `n` hangs on its pedestal
+ * (entity `hall:<n>`, a pedestal body, in the Hall room) and, for each
+ * field given: is of that `kind`, happened in room `place`, credits exactly
+ * the players `who`, has each named stat within [min, max] (a stat the
+ * record does not carry counts as 0), has that `title`, and its picture
+ * was taken on tick `frameAt`: every credited player's character is in the
+ * frame exactly where the world had it at the end of that tick.
+ * { "fact": "hall-record", "n": 2, "at": 600, "absent": true } says no such pedestal stands.
+ */
+const fact: Fact = {
+  id: 'hall-record',
+  validate(spec, scenario, content) {
+    const out: string[] = [];
+    checkOnly(spec, ['n', 'at', 'absent', 'kind', 'place', 'who', 'stats', 'title', 'frameAt'], out);
+    checkAt(spec, scenario, out);
+    if (typeof spec.n !== 'number' || !Number.isInteger(spec.n) || spec.n < 1) out.push(`n: must be a record number from 1, but is ${JSON.stringify(spec.n)}`);
+    if (spec.absent !== undefined && spec.absent !== true) out.push('absent: must be true or left out');
+    if (spec.absent === true && Object.keys(spec).some((k) => !['fact', '//', 'n', 'at', 'absent'].includes(k))) out.push('absent: a record that must not hang takes only n and at');
+    if (spec.kind !== undefined && (typeof spec.kind !== 'string' || !(spec.kind in content.hall.kinds))) out.push(`kind: no kind of legend ${JSON.stringify(spec.kind)} (kinds: ${known(content.hall.kinds)})`);
+    if (spec.place !== undefined && (typeof spec.place !== 'string' || !(spec.place in content.rooms))) out.push(`place: no room ${JSON.stringify(spec.place)}`);
+    if (spec.who !== undefined && (!Array.isArray(spec.who) || spec.who.some((p) => !scenario.players.some((q) => q.id === p)))) {
+      out.push(`who: must list players of this scenario (${scenario.players.map((p) => p.id).join(', ')}), but is ${JSON.stringify(spec.who)}`);
+    }
+    if (spec.stats !== undefined) {
+      if (!isRecord(spec.stats)) out.push(`stats: must be an object of stat id: [min, max], but is ${describe(spec.stats)}`);
+      else {
+        for (const [id, range] of Object.entries(spec.stats)) {
+          if (!(id in content.hall.stats)) out.push(`stats.${id}: no stat "${id}" (stats: ${known(content.hall.stats)})`);
+          else if (!isRange(range)) out.push(`stats.${id}: must be [min, max], but is ${JSON.stringify(range)}`);
+        }
+      }
+    }
+    if (spec.title !== undefined && typeof spec.title !== 'string') out.push(`title: must be text, but is ${describe(spec.title)}`);
+    if (spec.frameAt !== undefined && (!isTick(spec.frameAt, scenario) || spec.frameAt >= scenario.ticks)) out.push(`frameAt: must be a tick from 0 to ${scenario.ticks - 1}, but is ${JSON.stringify(spec.frameAt)}`);
+    return out;
+  },
+  test(spec, rec) {
+    const at = spec.at as number;
+    const id = pedestalId(spec.n as number);
+    const e = rec.history[at]?.entities.find((x) => x.id === id);
+    const hung = rec.events.filter((ev) => ev.type === 'hall-legend' || ev.type === 'hall-passed').map((ev) => JSON.stringify(ev));
+    const story = `Hall events in this run: ${hung.join(' ') || 'none'}`;
+    if (spec.absent === true) return e ? `${id} stands at tick ${at}, expected no such pedestal; ${story}` : null;
+    if (!e) return `no entity ${id} at tick ${at}; ${story}`;
+    const record = e.c.hall?.record;
+    if (!record) return `${id} carries no record (entity.c.hall) at tick ${at}`;
+    const wrong: string[] = [];
+    if (e.kind !== PEDESTAL_KIND) wrong.push(`its body is the kind "${e.kind}", expected "${PEDESTAL_KIND}"`);
+    if (e.room !== rec.content.hall.room) wrong.push(`it stands in room "${e.room}", expected the Hall room "${rec.content.hall.room}"`);
+    if (record.n !== spec.n) wrong.push(`its record says n ${record.n}`);
+    if (spec.kind !== undefined && record.kind !== spec.kind) wrong.push(`kind is "${record.kind}", expected "${String(spec.kind)}"`);
+    if (spec.place !== undefined && record.place !== spec.place) wrong.push(`place is "${record.place}", expected "${String(spec.place)}"`);
+    if (spec.title !== undefined && record.title !== spec.title) wrong.push(`title is ${JSON.stringify(record.title)}, expected ${JSON.stringify(spec.title)}`);
+    if (spec.who !== undefined) {
+      const got = record.who.map((w) => w.player).sort();
+      const want = [...(spec.who as string[])].sort();
+      if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push(`it credits ${JSON.stringify(got)}, expected ${JSON.stringify(want)}`);
+    }
+    for (const [stat, range] of Object.entries((spec.stats as Record<string, [number, number]> | undefined) ?? {})) {
+      const v = record.stats[stat] ?? 0;
+      if (v < range[0] || v > range[1]) wrong.push(`stat ${stat} is ${v}, expected ${range[0]} to ${range[1]} (its stats: ${JSON.stringify(record.stats)})`);
+    }
+    if (spec.frameAt !== undefined) {
+      // The detector runs last in a tick, so the picture of tick T is the world as that step left it.
+      const then = rec.history[(spec.frameAt as number) + 1]!;
+      if (record.frame.room !== record.place) wrong.push(`the picture is of room "${record.frame.room}", not of "${record.place}"`);
+      for (const w of record.who) {
+        const p = then.entities.find((x) => x.player === w.player);
+        if (!p) continue;
+        const want = [p.kind, Math.round(p.x), Math.round(p.y), p.facing];
+        const found = record.frame.bodies.some((b) => (b[4] & FRAME_CREDITED) !== 0 && JSON.stringify(b.slice(0, 4)) === JSON.stringify(want));
+        if (!found) wrong.push(`the picture was not taken on tick ${String(spec.frameAt)}: player ${w.player} was then ${JSON.stringify(want)}, and the picture holds ${JSON.stringify(record.frame.bodies)}`);
+      }
+    }
+    return wrong.length ? `${id} at tick ${at}: ${wrong.join('; ')}` : null;
+  },
+};
+export default fact;
