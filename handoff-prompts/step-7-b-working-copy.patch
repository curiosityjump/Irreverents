@@ -0,0 +1,84 @@
+// The detector's own notes: one bodiless entity, `hall:watch`
+// (docs/mechanisms/hall-of-legends.md, "The two entities").
+import type { EpisodeId } from '../../content/kinds/hall.ts';
+import type { Entity, World } from '../types.ts';
+import { addEntity, findEntity } from '../world.ts';
+import type { FrameBody } from './record.ts';
+
+export const WATCH_ID = 'hall:watch';
+/**
+ * INTENT: never a character kind. Physics, the verbs system and the entity
+ * drawer skip a kind they do not know, so the watcher has no body, cannot
+ * be hit and is never drawn; `room: ''` keeps it out of every room.
+ */
+export const WATCH_KIND = 'hall-watch';
+
+/** DRAFT: the budgets the Step 7 lead set, because every entity goes to every phone about 20 times a second. */
+export const WATCH_MAX_BYTES = 800;
+export const PEDESTAL_MAX_BYTES = 500;
+
+/** Something under way that may turn out to be a legend. Short field names: this is sent to every phone. */
+export interface Episode {
+  /** The episode shape (content/hall: `trouble` or `quiet`). */
+  e: EpisodeId;
+  /** Where: a room id tonight. */
+  area: string;
+  /** The tick it opened. A start tick, never a running clock, so the watcher only changes when something happens. */
+  t0: number;
+  /** Everyone credited so far: [player id, the character they were when first seen there]. */
+  who: [player: string, character: string][];
+  /** Stat id -> the count so far (content/hall, `stats`). Absent means 0. */
+  s: Record<string, number>;
+  /** The fastest impact so far, or 0 before any. */
+  fs: number;
+  /** The candidate picture (see record.ts, `frame.bodies`). */
+  f: FrameBody[];
+  /** A quiet episode: the tick it closes on if nothing spoils it. */
+  until?: number;
+}
+
+export interface HallWatch {
+  /** The number the next record gets. */
+  next: number;
+  open: Episode[];
+  /** The best score hung so far, by `<kind>@<place>`. */
+  best: Record<string, number>;
+  /** Each area's alert as the detector last heard it; an area at 0 has no entry. */
+  alert: Record<string, number>;
+  /** Entity ids of players' characters heard knocked out and not yet heard back up, sorted. */
+  out: string[];
+}
+
+declare module '../types.ts' {
+  interface Components {
+    /**
+     * On `hall:watch` only.
+     * INTENT: every note the detector keeps is here, on an entity: nothing
+     * at module level (the simulation must be deterministic and a world
+     * must be plain JSON), and the network replicates entities and nothing else.
+     */
+    hallWatch?: HallWatch;
+  }
+}
+
+export const bestKey = (kind: string, place: string): string => `${kind}@${place}`;
+
+/** The watcher entity, made the first time it is wanted. */
+export function ensureWatch(world: World): Entity {
+  return (
+    findEntity(world, WATCH_ID) ??
+    addEntity(world, {
+      id: WATCH_ID,
+      kind: WATCH_KIND,
+      player: null,
+      room: '',
+      x: 0,
+      y: 0,
+      vx: 0,
+      vy: 0,
+      facing: 1,
+      onGround: true,
+      c: { hallWatch: { next: 1, open: [], best: {}, alert: {}, out: [] } },
+    })
+  );
+}
