 import { systems } from './registry.ts';
 import type { Input, SimEvent, StepContext, World } from './types.ts';
 
+/**
+ * An event put on a tick's list from outside the simulation: its type and
+ * fields, without `tick` (step() stamps it).
+ * INTENT (Step 7): this exists so a scenario can script an event that a
