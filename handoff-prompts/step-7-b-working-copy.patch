+// Putting records in the world: a record is a pedestal entity `hall:<n>`
+// in the Hall room (docs/mechanisms/hall-of-legends.md).
+import type { Content } from '../../content/types.ts';
+import type { Entity, World } from '../types.ts';
+import { addEntity, findEntity, removeEntity } from '../world.ts';
+import { PEDESTAL_KIND, pedestalId } from './record.ts';
+import type { HallRecord } from './record.ts';
+import { PEDESTAL_MAX_BYTES, bestKey, ensureWatch } from './watch.ts';
+
+/**
+ * Hangs one record: notes it on the watcher (the next number, the best
+ * score of its kind and place) and stands its pedestal in the Hall room.
+ * Returns the pedestal. Safe to call for a record already hung.
+ *
+ * INTENT: the pedestal is an ordinary body of an ordinary character kind
+ * ("Do not ... protect the Hall of Legends from gameplay", design library
+ * doc 00). Nothing here pins it, shields it or puts it back: it can be
+ * hit, grabbed and thrown, and the record rides on it.
+ */
+export function hangRecord(world: World, content: Content, record: HallRecord): Entity {
+  const watch = ensureWatch(world).c.hallWatch!;
+  if (record.n >= watch.next) watch.next = record.n + 1;
+  const key = bestKey(record.kind, record.place);
+  if (!(key in watch.best) || record.score > watch.best[key]!) watch.best[key] = record.score;
+
+  const already = findEntity(world, pedestalId(record.n));
+  if (already) return already;
+
+  const room = content.rooms[content.hall.room]!;
+  const body = content.characters[PEDESTAL_KIND]!;
+  const tiles = content.hall.pedestals;
+  const standing = world.entities.filter((e) => e.c.hall);
+  let slot = tiles.findIndex((_, i) => !standing.some((e) => e.c.hall!.slot === i));
+  if (slot < 0) {
+    // DRAFT (the worker's call, docs/decisions-log.md): when every tile is
+    // taken, the oldest record that has since been beaten leaves the floor;
+    // if none has been beaten, the oldest. The store keeps every record
+    // regardless: this only decides what stands in the room.
+    const byAge = [...standing].sort((a, b) => a.c.hall!.record.n - b.c.hall!.record.n);
+    const beaten = byAge.find((e) => e.c.hall!.record.score < (watch.best[bestKey(e.c.hall!.record.kind, e.c.hall!.record.place)] ?? 0));
+    const leaving = beaten ?? byAge[0]!;
+    slot = leaving.c.hall!.slot ?? 0;
+    removeEntity(world, leaving.id);
+  }
+  const [tx, ty] = tiles[slot]!;
+  const copy = JSON.parse(JSON.stringify(record)) as HallRecord;
+  const pedestal = addEntity(world, {
+    id: pedestalId(record.n),
+    kind: body.id,
+    player: null,
+    room: room.id,
+    x: tx * room.tile + (room.tile - body.box.w) / 2,
+    y: (ty + 1) * room.tile - body.box.h,
+    vx: 0,
+    vy: 0,
+    facing: 1,
+    onGround: true,
+    c: { hall: { record: copy, slot } },
+  });
+  // The budget: a pedestal goes to every phone many times a second. The
+  // picture gives way first, from its far end (the bodies furthest from the
+  // credited players), never the names or the numbers.
+  while (copy.frame.bodies.length > 0 && JSON.stringify(pedestal).length > PEDESTAL_MAX_BYTES) copy.frame.bodies.pop();
+  return pedestal;
+}
+
+/**
+ * Puts the Hall back as it was: the watcher, and every stored record in
+ * the order hung. What the server calls when it creates a world.
+ */
+export function restoreHall(world: World, content: Content, records: readonly HallRecord[]): void {
+  ensureWatch(world);
+  for (const r of [...records].sort((a, b) => a.n - b.n)) hangRecord(world, content, r);
+}
