+{
+  "id": "step7-escape-is-remembered",
+  "//": "The events are scripted by hand: the systems that will really emit them (Step 4's calls and alert, Step 2's hits and impacts) are not built yet. So this proves how the detector handles such events, never that the game produces them, and it is deliberately not tagged for gate E.",
+  "proves": "an escape is noticed by itself and remembered: help is called on two players, there is a hit and a crash, and the alert dies down with both still standing; one record of the escape kind hangs on a pedestal in the Hall room crediting both players (D-026), with numbers counted from the events themselves and its picture taken at the crash, not at the end",
+  "room": "test-body",
+  "players": [
+    {"id": "a", "character": "hero", "spawn": 0},
+    {"id": "b", "character": "hero", "spawn": 1}
+  ],
+  "entities": [
+    {"id": "dummy-1", "character": "dummy", "tile": [16, 9]}
+  ],
+  "inputs": [
+    {"player": "a", "from": 30, "to": 100, "x": -1},
+    {"player": "a", "from": 140, "to": 170, "x": 1},
+    {"player": "b", "from": 100, "to": 160, "x": 1}
+  ],
+  "events": [
+    {"at": 60, "type": "call-completed", "by": "dummy-1", "area": "test-body", "x": 260, "y": 150},
+    {"at": 60, "type": "alert-changed", "area": "test-body", "from": 0, "to": 1},
+    {"at": 120, "type": "hit", "by": "p:a", "target": "dummy-1", "player": "a"},
+    {"at": 130, "type": "hit", "by": "dummy-1", "target": "p:b", "player": null},
+    {"at": 150, "type": "impact", "entity": "dummy-1", "player": null, "other": null, "speed": 240},
+    {"at": 780, "type": "alert-changed", "area": "test-body", "from": 1, "to": 0}
+  ],
+  "ticks": 800,
+  "expect": [
+    {"fact": "event", "event": "hall-legend", "between": [780, 780], "count": [1, 1]},
+    {"fact": "event", "event": "hall-legend", "between": [0, 800], "count": [1, 1]},
+    {"fact": "event", "event": "hall-passed", "between": [0, 800], "count": [0, 0]},
+    {
+      "fact": "hall-record",
+      "n": 1,
+      "at": 800,
+      "kind": "escape",
+      "place": "test-body",
+      "who": [
+        "a",
+        "b"
+      ],
+      "title": "Gone from Test: bodies",
+      "stats": {"seconds": [12, 12], "highestAlert": [1, 1], "calls": [1, 1], "hits": [1, 1], "biggestImpact": [240, 240], "fell": [0, 0], "knockedOut": [0, 0]},
+      "frameAt": 150
+    },
+    {"fact": "hall-record", "n": 1, "at": 779, "absent": true},
+    {"fact": "entity-bytes", "entity": "hall:1", "between": [0, 800], "max": 500},
+    {"fact": "entity-bytes", "entity": "hall:watch", "between": [0, 800], "max": 800}
+  ]
+}
