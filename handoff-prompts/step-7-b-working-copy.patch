+// The legend detector: notices a feat from what happened, by itself
+// (docs/mechanisms/hall-of-legends.md). Called once a tick by
+// src/sim/systems/hall-detect.ts, after every other system.
+import type { EpisodeId, Hall, HallKind, HallStat, Signal, SignalId } from '../../content/kinds/hall.ts';
+import type { Content } from '../../content/types.ts';
+import { TICK_RATE } from '../types.ts';
+import type { Entity, StepContext, World } from '../types.ts';
+import { findEntity } from '../world.ts';
+import { hangRecord } from './hang.ts';
+import { FRAME_CREDITED, FRAME_MAX_BODIES, FRAME_OUT } from './record.ts';
+import type { FrameBody, HallRecord } from './record.ts';
+import { WATCH_ID, WATCH_MAX_BYTES, bestKey, ensureWatch } from './watch.ts';
+import type { Episode, HallWatch } from './watch.ts';
+
+declare module '../types.ts' {
+  interface EventMap {
+    /** A feat was recognised and its record hung on a pedestal (`hall:<record.n>`). */
+    'hall-legend': { record: HallRecord };
+    /** An episode ended as a kind of legend but hung nothing: under that kind's floor, or no greater than the best of its kind in that place. */
+    'hall-passed': { kind: string; place: string; score: number; why: 'below-floor' | 'not-greater' };
+  }
+}
+
+/**
+ * Any event, read by field name. The detector takes every event name and
+ * field name from content/hall/hall.json, so it never names another step's
+ * event in code and a rename is a content edit.
+ */
+type Ev = { type: string } & Record<string, unknown>;
+
+function matches(ev: Ev, event: string | undefined, match: Record<string, unknown>): boolean {
+  if (ev.type !== event) return false;
+  for (const k of Object.keys(match)) if (ev[k] !== match[k]) return false;
+  return true;
+}
+
+const isSignal = (ev: Ev, s: Signal): boolean => matches(ev, s.event, s.match);
+
+/** Where an event happened: a field that holds a room id, else the room of an entity it names. */
+function placeOf(world: World, hall: Hall, ev: Ev): string | null {
+  for (const f of hall.where.fields) {
+    const v = ev[f];
+    if (typeof v === 'string' && v !== '') return v;
+  }
+  for (const f of hall.where.entities) {
+    const v = ev[f];
+    const e = typeof v === 'string' ? findEntity(world, v) : undefined;
+    if (e && e.room !== '') return e.room;
+  }
+  return null;
+}
+
+/**
+ * Knocked out: Step 2's published `entity.c.flattened` (docs/architecture.md,
+ * "Bodies"), or heard knocked out through the `down` signal and not yet
+ * back up.
+ * DRAFT: the second half exists because Step 2's knock-outs were not on
+ * `main` when this was written, so the scenarios can only script the
+ * events. Once they are, reading `c.flattened` alone would do.
+ */
+function isOut(watch: HallWatch, e: Entity): boolean {
+  return (e.c as { flattened?: unknown }).flattened !== undefined || watch.out.includes(e.id);
+}
+
+/**
+ * The picture: who stands where in `area` right now, in whole pixels. The
+ * players first, then whoever is nearest to them, FRAME_MAX_BODIES at most.
+ */
+function capture(world: World, content: Content, watch: HallWatch, area: string): FrameBody[] {
+  const centre = (e: Entity): { x: number; y: number } => {
+    const box = content.characters[e.kind]!.box;
+    return { x: e.x + box.w / 2, y: e.y + box.h / 2 };
+  };
+  const bodies = world.entities.filter((e) => e.room === area && content.characters[e.kind]);
+  const players = bodies.filter((e) => e.player !== null).map(centre);
+  const far = (e: Entity): number => {
+    if (e.player !== null) return -1;
+    const c = centre(e);
+    let best = Infinity;
+    for (const p of players) best = Math.min(best, (p.x - c.x) ** 2 + (p.y - c.y) ** 2);
+    return best;
+  };
+  // world.entities is in id order and the sort is stable, so ties fall the same way on every device.
+  return bodies
+    .map((e) => ({ e, d: far(e) }))
+    .sort((a, b) => a.d - b.d)
+    .slice(0, FRAME_MAX_BODIES)
+    .map(({ e }): FrameBody => [e.kind, Math.round(e.x), Math.round(e.y), e.facing, (e.player !== null ? FRAME_CREDITED : 0) | (isOut(watch, e) ? FRAME_OUT : 0)]);
+}
+
+function countStat(world: World, stat: HallStat, ev: Ev, s: Record<string, number>, id: string): void {
+  if (stat.how === 'seconds' || !matches(ev, stat.event, stat.match)) return;
+  if (stat.who !== undefined) {
+    const named = ev[stat.who];
+    const e = typeof named === 'string' ? findEntity(world, named) : undefined;
+    if (!e || (e.player !== null) !== (stat.is === 'player')) return;
+  }
+  if (stat.how === 'count') {
+    s[id] = (s[id] ?? 0) + 1;
+    return;
+  }
+  const v = ev[stat.field!];
+  if (typeof v !== 'number' || !Number.isFinite(v)) return;
+  if (stat.how === 'sum') s[id] = (s[id] ?? 0) + v;
+  else if (!(id in s) || v > s[id]!) s[id] = v;
+}
+
+function titleOf(content: Content, kind: HallKind, n: number, place: string, stats: Record<string, number>): string {
+  // INTENT: picked by the record's number, never at random: the simulation has no dice.
+  const template = kind.titles[n % kind.titles.length]!;
+  return template.replace(/\{([^}]*)\}/g, (_, slot: string) => (slot === 'place' ? (content.rooms[place]?.name ?? place) : String(stats[slot] ?? 0)));
+}
+
+/** An episode is over, in one of the ways its shape can end. Hangs a record, passes, or (nobody was there) says nothing. */
+function close(ctx: StepContext, watch: HallWatch, ep: Episode, ending: string): void {
+  const { world, content } = ctx;
+  watch.open.splice(watch.open.indexOf(ep), 1);
+  if (ep.who.length === 0) return;
+  const kind = Object.values(content.hall.kinds).find((k) => k.episode === ep.e && k.ending === ending);
+  if (!kind) return;
+
+  const ticks = world.tick - ep.t0;
+  const stats: Record<string, number> = {};
+  for (const [id, stat] of Object.entries(content.hall.stats)) {
+    const v = Math.round(stat.how === 'seconds' ? ticks / TICK_RATE : (ep.s[id] ?? 0));
+    // Only what happened is kept: a zero is left out (the record must stay small).
+    if (v !== 0) stats[id] = v;
+  }
+  let score = 0;
+  for (const [id, weight] of Object.entries(kind.score)) score += weight * (stats[id] ?? 0);
+  score = Math.round(score);
+
+  // INTENT (design library doc 09: "they should feel rare and earned"): each kind has a floor.
+  if (score < kind.floor) {
+    ctx.emit('hall-passed', { kind: kind.id, place: ep.area, score, why: 'below-floor' });
+    return;
+  }
+  // DRAFT (S-001, a direction: "events of unusual greatness relative to past
+  // exploits"): a feat hangs only if nothing of its kind hangs for that
+  // place yet, or it beats the best one. The same feat again hangs nothing.
+  const best = watch.best[bestKey(kind.id, ep.area)];
+  if (best !== undefined && score <= best) {
+    ctx.emit('hall-passed', { kind: kind.id, place: ep.area, score, why: 'not-greater' });
+    return;
+  }
+  const n = watch.next;
+  const record: HallRecord = {
+    v: 1,
+    n,
+    kind: kind.id,
+    title: titleOf(content, kind, n, ep.area, stats),
+    place: ep.area,
+    ticks,
+    // INTENT (D-026): everyone who took part is credited, whoever started or finished it.
+    who: [...ep.who].sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0)).map(([player, character]) => ({ player, character })),
+    stats,
+    score,
+    frame: { room: ep.area, bodies: ep.f },
+  };
+  ctx.emit('hall-legend', { record: hangRecord(world, content, record).c.hall!.record });
+}
+
+/**
+ * One tick of noticing.
+ *
+ * INTENT (design library doc 00, "Do not turn the Hall into a preset
+ * achievements checklist instead of a memory of actual events"): this
+ * reads only what happened (this tick's events, and who is where) and
+ * nothing in a room, a person or a scenario can say "this is a legend".
+ * Do not add a way to award one.
+ *
+ * INTENT (rule 7 of the step's brief; CLAUDE.md, "There is always a way
+ * out"): getting recognised never holds anyone. Nothing here pauses,
+ * freezes or moves a player, and no state here is one a player is in.
+ *
+ * DRAFT: the two episode shapes below (trouble; a quiet theft) and "taking
+ * part = a player whose character was in the area on any tick of the
+ * episode, knocked out or not" are the Step 7 lead's first reading
+ * (docs/decisions-log.md, 2026-11-23); the kinds, floors, weights, stats
+ * and event names are data in content/hall/hall.json.
+ */
+export function detect(ctx: StepContext): void {
+  const { world, content } = ctx;
+  const hall = content.hall;
+  const sig = hall.signals;
+  // A copy: closing an episode emits, and the list must not grow under the loop.
+  const events = [...ctx.events] as unknown as Ev[];
+  const watch = ensureWatch(world).c.hallWatch!;
+  // INTENT: nothing below writes to the watcher on a tick when nothing
+  // happened; it is sent to every phone, and holds start ticks, not clocks.
+  if (events.length === 0 && watch.open.length === 0) return;
+
+  const tick = world.tick;
+  const openIn = (e: EpisodeId, area: string): Episode | undefined => watch.open.find((ep) => ep.e === e && ep.area === area);
+  const drop = (ep: Episode | undefined): void => {
+    if (ep) watch.open.splice(watch.open.indexOf(ep), 1);
+  };
+  const has = (id: SignalId, ev: Ev): boolean => isSignal(ev, sig[id]);
+  const field = (id: SignalId, name: string, ev: Ev): unknown => ev[sig[id].fields[name]!];
+
+  const rose = new Set<string>();
+  const calm = new Set<string>();
+  const noticed = new Set<string>();
+  const shot = new Set<Episode>();
+  let grew = false;
+
+  // 1 · What was heard: knock-outs, alerts, calls.
+  for (const ev of events) {
+    if (has('down', ev) || has('up', ev)) {
+      const down = has('down', ev);
+      const who = field(down ? 'down' : 'up', 'who', ev);
+      const e = typeof who === 'string' ? findEntity(world, who) : undefined;
+      if (e && e.player !== null) {
+        if (down && !watch.out.includes(e.id)) watch.out = [...watch.out, e.id].sort();
+        else if (!down && watch.out.includes(e.id)) watch.out = watch.out.filter((id) => id !== e.id);
+      }
+    }
+    if (has('alert', ev)) {
+      const area = placeOf(world, hall, ev);
+      const from = field('alert', 'from', ev);
+      const to = field('alert', 'to', ev);
+      if (area === null || typeof from !== 'number' || typeof to !== 'number') continue;
+      if (to > 0) watch.alert[area] = to;
+      else delete watch.alert[area];
+      if (to > from) {
+        rose.add(area);
+        noticed.add(area);
+        // Trouble opens when an area's alert rises from 0.
+        if (from === 0 && !openIn('trouble', area)) {
+          watch.open.push({ e: 'trouble', area, t0: tick, who: [], s: {}, fs: 0, f: [] });
+          grew = true;
+        }
+      }
+      if (to === 0) calm.add(area);
+    }
+    if (has('call', ev)) {
+      const area = placeOf(world, hall, ev);
+      if (area !== null) noticed.add(area);
+    }
+  }
+  if (watch.out.length > 0 && watch.out.some((id) => !findEntity(world, id))) watch.out = watch.out.filter((id) => findEntity(world, id));
+
+  // A quiet theft that was noticed (the alert rose, or a call started there) closes as nothing.
+  for (const area of noticed) drop(openIn('quiet', area));
+
+  // 2 · A player took something where all was calm: a quiet theft opens (or, already open, counts on).
+  for (const ev of events) {
+    if (!has('taking', ev)) continue;
+    const by = field('taking', 'by', ev);
+    const taker = typeof by === 'string' ? findEntity(world, by) : undefined;
+    const area = placeOf(world, hall, ev);
+    if (!taker || taker.player === null || area === null) continue;
+    if ((watch.alert[area] ?? 0) !== 0 || noticed.has(area) || openIn('trouble', area)) continue;
+    const until = tick + Math.round(hall.quietSeconds * TICK_RATE);
+    const ep = openIn('quiet', area);
+    // DRAFT: a second taking while one is still being judged is the same
+    // theft, and every taking needs its own quiet seconds after it.
+    if (ep) ep.until = until;
+    else {
+      const opened: Episode = { e: 'quiet', area, t0: tick, who: [], s: {}, fs: 0, f: [], until };
+      watch.open.push(opened);
+      shot.add(opened);
+      grew = true;
+    }
+  }
+
+  for (const ep of [...watch.open]) {
+    // 3 · Credit: every player whose character is in the area on any tick of the episode.
+    for (const e of world.entities) {
+      if (e.player === null || e.room !== ep.area || ep.who.some(([p]) => p === e.player)) continue;
+      ep.who.push([e.player, e.kind]);
+      grew = true;
+    }
+
+    // 4 · The numbers, and the moment worth a picture.
+    for (const ev of events) {
+      if (placeOf(world, hall, ev) !== ep.area) continue;
+      for (const [id, stat] of Object.entries(hall.stats)) countStat(world, stat, ev, ep.s, id);
+      if (ep.e === 'trouble' && has('impact', ev)) {
+        const speed = field('impact', 'speed', ev);
+        if (typeof speed === 'number' && speed > ep.fs) {
+          ep.fs = speed;
+          shot.add(ep);
+        }
+      }
+    }
+    // INTENT: the picture is the "OHH" moment, not the end: for trouble the
+    // fastest impact so far (until there is one, when the alert last rose);
+    // for a quiet theft, the taking.
+    if (ep.e === 'trouble' && ep.fs === 0 && rose.has(ep.area)) shot.add(ep);
+    if (shot.has(ep)) {
+      ep.f = capture(world, content, watch, ep.area);
+      grew = true;
+    }
+
+    // 5 · Endings.
+    if (ep.e === 'trouble') {
+      const here = world.entities.filter((e) => e.player !== null && e.room === ep.area);
+      const standing = ep.who.some(([p]) => {
+        const e = world.entities.find((x) => x.player === p);
+        return e !== undefined && !isOut(watch, e);
+      });
+      // A last stand: every credited player still in the area is knocked out at once (losing counts).
+      if (here.length > 0 && here.every((e) => isOut(watch, e))) close(ctx, watch, ep, 'all-down');
+      // An escape: the alert is back to 0 with somebody still standing.
+      else if (calm.has(ep.area)) {
+        if (standing) close(ctx, watch, ep, 'calm');
+        else if (ep.who.some(([p]) => world.entities.some((x) => x.player === p))) close(ctx, watch, ep, 'all-down');
+        else drop(ep);
+      }
+    } else if (ep.until !== undefined && tick >= ep.until) close(ctx, watch, ep, 'unnoticed');
+  }
+
+  // The budget: pictures still being judged give way from their far end first.
+  if (grew) {
+    const self = findEntity(world, WATCH_ID)!;
+    while (JSON.stringify(self).length > WATCH_MAX_BYTES) {
+      const fullest = [...watch.open].sort((a, b) => b.f.length - a.f.length)[0];
+      if (!fullest || fullest.f.length === 0) break;
+      fullest.f.pop();
+    }
+  }
+}
