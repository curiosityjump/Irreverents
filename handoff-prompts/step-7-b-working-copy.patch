+  "proves": "the Hall comes back after a restart: two stored records are put back on their pedestals before anyone plays, and the detector remembers them: an escape no greater than the stored one and a theft no greater than the stored one hang nothing, and a greater escape hangs as record 3 (not 1), titled from its own numbers",
+  "room": "test-body",
+  "players": [
+    {"id": "a", "character": "hero", "spawn": 0},
+    {"id": "b", "character": "hero", "spawn": 1}
+  ],
+  "entities": [
+    {"id": "dummy-1", "character": "dummy", "tile": [16, 9]}
+  ],
+  "inputs": [
