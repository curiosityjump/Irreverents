diff --git a/src/content/kinds/hall.ts b/src/content/kinds/hall.ts
new file mode 100644
index 0000000..9de687a
--- /dev/null
+++ b/src/content/kinds/hall.ts
@@ -0,0 +1,247 @@
+import { describe, isRecord, known } from '../reader.ts';
+import type { ContentKind, Reader } from '../types.ts';
+
+/**
+ * content/hall/hall.json: everything the Hall of Legends is made of that
+ * is not code: where the pedestals stand, which of the simulation's events
+ * the detector listens to, what it counts, and the kinds of legend with
+ * their names, titles, floors and scoring (docs/mechanisms/hall-of-legends.md).
+ *
+ * INTENT (design library doc 00: "Do not turn the Hall into a preset
+ * achievements checklist instead of a memory of actual events"): nothing
+ * here names a place, a person or a deed to perform. It says how to
+ * recognise and weigh *what happened*; what a room or a person is never
+ * says "this is a legend".
+ */
+export interface Hall {
+  /** The room the pedestals stand in. */
+  room: string;
+  /** Where pedestals are put, [column, row], in the order they fill. */
+  pedestals: [number, number][];
+  /** How long, in seconds, a taking must stay unnoticed to be a quiet theft. */
+  quietSeconds: number;
+  /** The happenings the detector's episodes are built from, each mapped to one of the simulation's events. */
+  signals: Record<SignalId, Signal>;
+  /** How to tell where an event happened: fields that hold a room id, then fields that hold an entity id (its room is the place). */
+  where: { fields: string[]; entities: string[] };
+  stats: Record<string, HallStat>;
+  kinds: Record<string, HallKind>;
+}
+
+/**
+ * The six happenings the two episode shapes are built from. Which event
+ * each one is, and which of its fields to read, is data, so another step
+ * renaming an event is a one-line edit of content/hall/hall.json.
+ */
+export const SIGNALS = {
+  alert: { what: "an area's alert changed", fields: ['from', 'to'] },
+  call: { what: 'somebody started calling for help', fields: [] },
+  taking: { what: 'somebody took goods', fields: ['by'] },
+  impact: { what: 'a flying body struck something', fields: ['speed'] },
+  down: { what: 'a body was knocked out', fields: ['who'] },
+  up: { what: 'a knocked-out body got back up', fields: ['who'] },
+} as const;
+export type SignalId = keyof typeof SIGNALS;
+
+export interface Signal {
+  /** The event type. */
+  event: string;
+  /** Only events whose fields equal all of these count (e.g. `deed` with `{ "deed": "take" }`). */
+  match: Record<string, string | number | boolean>;
+  /** The signal's own field names (SIGNALS) -> the event's field names. */
+  fields: Record<string, string>;
+}
+
+export const STAT_HOWS = ['count', 'max', 'sum', 'seconds'] as const;
+export type StatHow = (typeof STAT_HOWS)[number];
+export const STAT_WHOSE = ['player', 'other'] as const;
+
+/** One number a record can carry, and how it is counted from the episode's events. */
+export interface HallStat {
+  /** Shown text. */
+  label: string;
+  /** count: how many such events; max / sum: of `field`; seconds: how long the episode lasted (no event). */
+  how: StatHow;
+  event?: string;
+  match: Record<string, string | number | boolean>;
+  /** For max and sum: the event field holding the number. */
+  field?: string;
+  /** Count only events whose `who` field names an entity that `is` a player's ("player") or nobody's ("other"). */
+  who?: string;
+  is?: (typeof STAT_WHOSE)[number];
+}
+
+/** The two episode shapes the detector knows (src/sim/hall/detect.ts) and the ways each can end as a legend. */
+export const EPISODES = { trouble: ['calm', 'all-down'], quiet: ['unnoticed'] } as const;
+export type EpisodeId = keyof typeof EPISODES;
+
+export interface HallKind {
+  id: string;
+  /** Shown name of the kind. */
+  name: string;
+  /** Which episode shape, and which ending of it, is this kind of legend. */
+  episode: EpisodeId;
+  ending: string;
+  /** Title templates: `{place}` and `{<stat id>}` are filled in. Picked by the record's number, never at random. */
+  titles: string[];
+  /** The least score that hangs anything. */
+  floor: number;
+  /** Stat id -> how much one of it adds to the score. */
+  score: Record<string, number>;
+}
+
+/** The character kind (content/characters/) a record's pedestal is. */
+export const PEDESTAL_CHARACTER = 'pedestal';
+
+declare module '../types.ts' {
+  interface Content {
+    hall: Hall;
+  }
+}
+
+const FILE = 'content/hall/hall.json';
+
+function matchOf(read: Reader, o: Record<string, unknown>, where: string): Record<string, string | number | boolean> {
+  const out: Record<string, string | number | boolean> = {};
+  if (o.match === undefined) return out;
+  const m = read.object(o.match, `${where}.match`);
+  for (const [k, v] of Object.entries(m ?? {})) {
+    if (k === '//') continue;
+    if (typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean') out[k] = v;
+    else read.fail(`${where}.match.${k}`, `must be text, a number or true/false, but is ${describe(v)}`);
+  }
+  return out;
+}
+
+const kind: ContentKind = {
+  id: 'hall',
+  source: { file: 'hall/hall.json' },
+  parse(raw, read) {
+    const out: Hall = { room: '', pedestals: [], quietSeconds: 1, signals: {} as Hall['signals'], where: { fields: [], entities: [] }, stats: {}, kinds: {} };
+    const o = read.object(raw, '');
+    if (!o) return out;
+    read.only(o, ['room', 'pedestals', 'quietSeconds', 'signals', 'where', 'stats', 'kinds'], '');
+    out.room = read.string(o, 'room', '');
+    out.quietSeconds = read.number(o, 'quietSeconds', '', { min: 0.1, max: 600 });
+
+    if (!Array.isArray(o.pedestals) || o.pedestals.length === 0) read.fail('pedestals', `must list at least one [column, row], but is ${describe(o.pedestals)}`);
+    else {
+      o.pedestals.forEach((t: unknown, i: number) => {
+        if (Array.isArray(t) && t.length === 2 && t.every((n) => Number.isInteger(n) && n >= 0)) out.pedestals.push([t[0], t[1]]);
+        else read.fail(`pedestals[${i}]`, `must be [column, row], but is ${JSON.stringify(t)}`);
+      });
+    }
+
+    const signals = read.object(o.signals, 'signals');
+    if (signals) {
+      read.only(signals, Object.keys(SIGNALS), 'signals');
+      for (const id of Object.keys(SIGNALS) as SignalId[]) {
+        const w = `signals.${id}`;
+        if (signals[id] === undefined) {
+          read.fail(w, `missing: the detector listens for it (${SIGNALS[id].what})`);
+          continue;
+        }
+        const s = read.object(signals[id], w);
+        if (!s) continue;
+        const names: readonly string[] = SIGNALS[id].fields;
+        read.only(s, ['event', 'match', ...names], w);
+        const fields: Record<string, string> = {};
+        for (const f of names) fields[f] = read.string(s, f, w);
+        out.signals[id] = { event: read.string(s, 'event', w), match: matchOf(read, s, w), fields };
+      }
+    }
+
+    const where = read.object(o.where, 'where');
+    if (where) {
+      read.only(where, ['fields', 'entities'], 'where');
+      out.where = { fields: read.stringList(where, 'fields', 'where'), entities: read.stringList(where, 'entities', 'where') };
+    }
+
+    const stats = read.object(o.stats, 'stats');
+    for (const [id, value] of Object.entries(stats ?? {})) {
+      if (id === '//') continue;
+      const w = `stats.${id}`;
+      // A stat id is a slot in a title template and a key in stored records, so it is kept to plain letters and digits.
+      if (!/^[a-z][A-Za-z0-9]*$/.test(id)) read.fail(w, `"${id}" is not a valid stat id: letters and digits only, starting with a lower-case letter`);
+      if (id === 'place') read.fail(w, '"place" is the title slot for where it happened; a stat needs another id');
+      const s = read.object(value, w);
+      if (!s) continue;
+      read.only(s, ['label', 'how', 'event', 'match', 'field', 'who', 'is'], w);
+      const how = s.how as StatHow;
