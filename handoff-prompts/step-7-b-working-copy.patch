+      if (how === 'seconds') {
+        for (const f of ['event', 'match', 'field', 'who', 'is']) if (s[f] !== undefined) read.fail(`${w}.${f}`, 'a "seconds" stat is the length of the episode and reads no event');
+      } else {
+        stat.event = read.string(s, 'event', w);
+        if (how === 'count') {
+          if (s.field !== undefined) read.fail(`${w}.field`, 'a "count" stat counts events and reads no field');
+        } else stat.field = read.string(s, 'field', w);
+        if ((s.who === undefined) !== (s.is === undefined)) read.fail(`${w}.who`, 'give who and is together (which field names an entity, and whether it must be a player\'s), or neither');
+        else if (s.who !== undefined) {
+          stat.who = read.string(s, 'who', w);
+          if (STAT_WHOSE.includes(s.is as 'player')) stat.is = s.is as 'player';
+          else read.fail(`${w}.is`, `must be one of ${STAT_WHOSE.join(', ')}, but is ${describe(s.is)}`);
+        }
+      }
+      out.stats[id] = stat;
+    }
+
+    const kinds = read.object(o.kinds, 'kinds');
+    for (const [id, value] of Object.entries(kinds ?? {})) {
+      if (id === '//') continue;
+      const w = `kinds.${id}`;
+      if (!/^[a-z][a-z0-9]*(-[a-z0-9]+)*$/.test(id)) read.fail(w, `"${id}" is not a valid id: use lower-case letters, digits and dashes, starting with a letter`);
+      const k = read.object(value, w);
+      if (!k) continue;
+      read.only(k, ['name', 'episode', 'ending', 'titles', 'floor', 'score'], w);
+      const hk: HallKind = { id, name: read.string(k, 'name', w), episode: 'trouble', ending: '', titles: read.stringList(k, 'titles', w), floor: read.number(k, 'floor', w, { min: 0 }), score: {} };
+      if (typeof k.episode === 'string' && Object.hasOwn(EPISODES, k.episode)) {
+        hk.episode = k.episode as EpisodeId;
+        const endings: readonly string[] = EPISODES[hk.episode];
+        if (typeof k.ending === 'string' && endings.includes(k.ending)) hk.ending = k.ending;
+        else read.fail(`${w}.ending`, `must be one of ${endings.join(', ')} (the ways a "${hk.episode}" episode can end as a legend), but is ${describe(k.ending)}`);
+      } else read.fail(`${w}.episode`, `must be one of ${Object.keys(EPISODES).join(', ')}, but is ${describe(k.episode)}`);
+      if (hk.titles.length === 0) read.fail(`${w}.titles`, 'must hold at least one title');
+      hk.titles.forEach((t, i) => {
+        for (const slot of t.match(/\{[^}]*\}/g) ?? []) {
+          const name = slot.slice(1, -1);
+          if (name !== 'place' && !(isRecord(stats) && name in stats)) read.fail(`${w}.titles[${i}]`, `unknown slot ${slot}: use {place} or a stat id in braces (stats: ${isRecord(stats) ? known(stats) : 'none'})`);
+        }
+      });
+      const score = read.object(k.score, `${w}.score`);
+      for (const [stat, weight] of Object.entries(score ?? {})) {
+        if (stat === '//') continue;
+        if (!(isRecord(stats) && stat in stats)) read.fail(`${w}.score.${stat}`, `no stat "${stat}" (stats: ${isRecord(stats) ? known(stats) : 'none'})`);
+        else if (typeof weight !== 'number' || !Number.isFinite(weight)) read.fail(`${w}.score.${stat}`, `must be a number, but is ${describe(weight)}`);
+        else hk.score[stat] = weight;
+      }
+      out.kinds[id] = hk;
+    }
+    // Two kinds with the same episode and ending would both claim the same happening.
+    const seen: Record<string, string> = {};
+    for (const k of Object.values(out.kinds)) {
+      const key = `${k.episode}/${k.ending}`;
+      if (k.ending !== '' && seen[key] !== undefined) read.fail(`kinds.${k.id}.ending`, `kind "${seen[key]}" is already the "${k.ending}" ending of a "${k.episode}" episode`);
+      seen[key] = k.id;
+    }
+    return out;
+  },
+  check(content, fail) {
+    const h = content.hall;
+    const room = content.rooms[h.room];
+    if (!room) fail(FILE, 'room', `no room "${h.room}" (rooms: ${known(content.rooms)})`);
+    else {
+      h.pedestals.forEach(([tx, ty], i) => {
+        if (tx >= room.w || ty >= room.h) fail(FILE, `pedestals[${i}]`, `[${tx}, ${ty}] is outside room "${room.id}", which is ${room.w} by ${room.h} tiles`);
+      });
+    }
+    if (!(PEDESTAL_CHARACTER in content.characters)) {
+      fail(`content/characters/${PEDESTAL_CHARACTER}.json`, '(the whole file)', 'missing: a Hall record hangs on a body of this character kind');
+    }
+  },
+};
