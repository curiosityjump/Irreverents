diff --git a/content/hall/hall.json b/content/hall/hall.json
new file mode 100644
index 0000000..c72de38
--- /dev/null
+++ b/content/hall/hall.json
@@ -0,0 +1,52 @@
+{
+  "//": "The Hall of Legends as data (docs/mechanisms/hall-of-legends.md). DRAFT, all of it: the test room, the eight quiet seconds, every floor and weight, every name, label and title. Nothing here names a place, a person or a deed to perform: it says how to recognise and weigh what happened. 'signals' maps what the detector listens for to the simulation's events, so an event renamed by another step is a one-line edit here.",
+  "room": "test-hall",
+  "pedestals": [[3, 9], [6, 9], [9, 9], [12, 9], [15, 9], [4, 6], [14, 6]],
+  "quietSeconds": 8,
+  "signals": {
+    "alert": { "event": "alert-changed", "from": "from", "to": "to" },
+    "call": { "event": "call-started" },
+    "taking": { "event": "deed", "match": { "deed": "take" }, "by": "by" },
+    "impact": { "event": "impact", "speed": "speed" },
+    "down": { "event": "flattened", "who": "target" },
+    "up": { "event": "recovered", "who": "target" }
+  },
+  "where": { "fields": ["area", "room"], "entities": ["entity", "target", "by"] },
+  "stats": {
+    "seconds": { "label": "Seconds", "how": "seconds" },
+    "highestAlert": { "label": "Highest alert", "how": "max", "event": "alert-changed", "field": "to" },
+    "calls": { "label": "Calls for help", "how": "count", "event": "call-completed" },
+    "hits": { "label": "Hits landed", "how": "count", "event": "hit", "who": "by", "is": "player" },
+    "knockedOut": { "label": "Knocked out", "how": "count", "event": "flattened", "who": "target", "is": "other" },
+    "fell": { "label": "Heroes down", "how": "count", "event": "flattened", "who": "target", "is": "player" },
+    "biggestImpact": { "label": "Biggest crash", "how": "max", "event": "impact", "field": "speed" },
+    "throws": { "label": "Throws", "how": "count", "event": "thrown", "who": "by", "is": "player" },
+    "taken": { "label": "Things taken", "how": "count", "event": "deed", "match": { "deed": "take" }, "who": "by", "is": "player" }
+  },
+  "kinds": {
+    "infiltration": {
+      "name": "Quiet Theft",
+      "episode": "quiet",
+      "ending": "unnoticed",
+      "titles": ["The Quiet Hand at {place}", "Nobody Saw a Thing at {place}", "The Empty Shelf of {place}", "Light Fingers in {place}"],
+      "floor": 10,
+      "score": { "taken": 10 }
+    },
+    "escape": {
+      "name": "Narrow Escape",
+      "episode": "trouble",
+      "ending": "calm",
+      "titles": ["The Vanishing at {place}", "Gone from {place}", "The Slip at {place}", "{seconds} Seconds Loose in {place}"],
+      "floor": 15,
+      "score": { "seconds": 1, "highestAlert": 10, "calls": 5, "hits": 2, "knockedOut": 5, "throws": 3, "biggestImpact": 0.05 }
+    },
+    "last-stand": {
+      "name": "Last Stand",
+      "episode": "trouble",
+      "ending": "all-down",
+      "titles": ["The Stand at {place}", "Held to the End at {place}", "Down Swinging in {place}", "The Last of It at {place}"],
+      "floor": 20,
+      "score": { "seconds": 1, "highestAlert": 10, "calls": 5, "hits": 2, "knockedOut": 5, "throws": 3, "biggestImpact": 0.05 }
+    }
+  }
+}
