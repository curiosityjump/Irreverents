{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "src/**",
      "content/**",
      "scripts/**",
      "assets/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "tsconfig.pure.json",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "drainingSeconds": 10
  }
}
